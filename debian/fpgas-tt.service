[Unit]
Description=fpgas.online Tiny Tapeout demo-board bridge
Documentation=https://github.com/fpgas-online/fpgas.online-tt
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
SupplementaryGroups=dialout
# Visitors' uploads are kept here, on the Pi (/var/lib/fpgas-tt/uploads): never on the demo board.
StateDirectory=fpgas-tt
# What the board is comes from the board (its USB serial, and the boot check's report in /run/fpgas-online):
# no option says which Pi or which switch port this is.
ExecStart=/usr/bin/fpgas-tt --device /dev/ttboard
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
